[Unit]
Description=Gusto – Rezept-Webserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@GUSTO_USER@
WorkingDirectory="@GUSTO_PROJECT@"
Environment="GUSTO_HOME=@GUSTO_HOME@"
ExecStart="@GUSTO_PYTHON@" -m gusto serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
