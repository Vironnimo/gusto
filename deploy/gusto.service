[Unit]
Description=Gusto – Rezept-Webserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- an deine Umgebung anpassen ---
User=pi
WorkingDirectory=/home/pi/gusto
ExecStart=/home/pi/gusto/.venv/bin/python -m gusto serve --host 0.0.0.0 --port 8000
# Optional: Daten woanders ablegen (sonst neben dem Code)
# Environment=GUSTO_HOME=/home/pi/gusto-daten
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
