[Unit]
Description=Gusto Rezeptserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory="@GUSTO_DATA@"
ExecStart="@GUSTO_PYTHON@" -m gusto serve --host "@GUSTO_HOST@" --port @GUSTO_PORT@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
